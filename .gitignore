:root {
  --bg: #07131f;
  --bg-elevated: #0d1c2d;
  --panel: rgba(15, 30, 44, 0.9);
  --panel-border: rgba(128, 163, 194, 0.2);
  --text: #edf6ff;
  --muted: #9bb7cb;
  --primary: #4cc9f0;
  --good: #3ddc97;
  --warning: #fbbf24;
  --critical: #ff5f6d;
  --shadow: rgba(6, 17, 29, 0.42);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: radial-gradient(circle at top, #0d2237 0%, var(--bg) 50%);
  color: var(--text);
}

.page-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(76, 201, 240, 0.2), rgba(77, 143, 255, 0.2));
  border: 1px solid rgba(76, 201, 240, 0.4);
  color: var(--primary);
  font-size: 1.6rem;
}

.eyebrow {
  margin: 0 0 4px;
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.72rem;
}

h1, h2, p {
  margin: 0;
}

h1 {
  font-size: clamp(1.7rem, 3vw, 2.6rem);
}

.status-pill,
.panel-tag {
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid var(--panel-border);
  background: rgba(255,255,255,0.04);
  color: var(--text);
}

.dashboard {
  display: grid;
  grid-template-columns: 1.2fr 0.9fr;
  gap: 24px;
}

.panel {
  background: rgba(11, 19, 29, 0.9);
  border: 1px solid var(--panel-border);
  border-radius: 24px;
  box-shadow: 0 18px 50px var(--shadow);
  padding: 24px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.panel-tag.warning {
  color: var(--warning);
  border-color: rgba(251, 191, 36, 0.4);
  background: rgba(251, 191, 36, 0.08);
}

.panel-tag.good {
  color: var(--good);
  border-color: rgba(61, 220, 151, 0.45);
  background: rgba(61, 220, 151, 0.08);
}

.panel-tag.critical {
  color: var(--critical);
  border-color: rgba(255, 95, 109, 0.4);
  background: rgba(255, 95, 109, 0.08);
}

.grid {
  display: grid;
  gap: 18px;
}

.two-col {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
  font-size: 0.9rem;
}

input, select, button {
  border: 1px solid rgba(128, 163, 194, 0.18);
  background: rgba(255,255,255,0.03);
  color: var(--text);
  border-radius: 12px;
  padding: 12px 14px;
  font-size: 0.98rem;
  outline: none;
}

input:focus, select:focus {
  border-color: rgba(76, 201, 240, 0.7);
  box-shadow: 0 0 0 3px rgba(76, 201, 240, 0.1);
}

.primary-btn {
  margin-top: 20px;
  width: 100%;
  background: linear-gradient(135deg, var(--primary), #6a7cff);
  border: none;
  color: #041218;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 24px rgba(76, 201, 240, 0.25);
}

.risk-meter {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 20px;
  align-items: center;
  margin: 10px 0 22px;
}

.score-wrap {
  display: flex;
  justify-content: center;
}

.score-ring {
  --progress: 0%;
  display: grid;
  place-items: center;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: conic-gradient(var(--primary) var(--progress), rgba(255,255,255,0.08) var(--progress) 100%);
  position: relative;
}

.score-ring::before {
  content: "";
  position: absolute;
  inset: 16px;
  border-radius: 50%;
  background: rgba(4, 10, 16, 0.94);
  border: 1px solid rgba(128, 163, 194, 0.15);
}

#score-value {
  position: relative;
  z-index: 1;
  font-size: 2.2rem;
  font-weight: 800;
}

#summary {
  font-size: 1.08rem;
  line-height: 1.6;
  color: var(--text);
}

.muted {
  color: var(--muted);
  line-height: 1.6;
  margin-top: 8px;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.mini-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(128, 163, 194, 0.16);
  border-radius: 16px;
  padding: 15px 16px;
}

.label {
  display: block;
  color: var(--muted);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 8px;
}

strong {
  font-size: 1.1rem;
}

@media (max-width: 900px) {
  .dashboard {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .topbar,
  .panel-header,
  .risk-meter {
    grid-template-columns: 1fr;
    display: grid;
  }

  .two-col,
  .metrics-grid {
    grid-template-columns: 1fr;
  }

  .score-ring {
    width: 132px;
    height: 132px;
  }
}

